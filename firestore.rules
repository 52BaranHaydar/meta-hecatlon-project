rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /safety_circle_invites/{inviteCode} {
      allow get: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.status == 'pending');
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'ownerName',
          'status',
          'createdAt',
          'expiresAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledAt == request.time)
          || (resource.data.ownerUid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'acceptedBy', 'acceptedName', 'acceptedAt'])
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.acceptedName is string
            && request.resource.data.acceptedAt == request.time)
        );
      allow delete: if false;
    }

    match /safety_circle_connections/{connectionId} {
      allow get: if signedIn()
        && (!exists(
          /databases/$(database)/documents/safety_circle_connections/$(connectionId)
        )
          || request.auth.uid in resource.data.participantUids);
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantUids',
          'participantNames',
          'inviteCode',
          'createdAt'
        ])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.inviteCode == connectionId
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/safety_circle_invites/$(connectionId)
        ).data.status == 'accepted'
        && getAfter(
          /databases/$(database)/documents/safety_circle_invites/$(connectionId)
        ).data.acceptedBy == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/safety_circle_invites/$(connectionId)
        ).data.ownerUid in request.resource.data.participantUids;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participantUids;

      match /statuses/{userId} {
        function isConnectionMember() {
          return signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/safety_circle_connections/$(connectionId)
            ).data.participantUids;
        }

        allow get: if isConnectionMember();
        allow list: if false;
        allow create, update: if isConnectionMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'status',
            'reportedAt',
            'placeName',
            'latitude',
            'longitude'
          ])
          && request.resource.data.status in ['safe', 'help_requested']
          && request.resource.data.reportedAt == request.time
          && (!('placeName' in request.resource.data)
            || request.resource.data.placeName is string)
          && (!('latitude' in request.resource.data)
            || request.resource.data.latitude is number)
          && (!('longitude' in request.resource.data)
            || request.resource.data.longitude is number);
        allow delete: if isConnectionMember() && request.auth.uid == userId;
      }
    }
  }
}
